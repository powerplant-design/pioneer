---
layout: base.njk
title: Pioneer PGD
description: Plumbing, Gasfitting and Drainlaying servicing Upper Hutt, Pinehaven, Trentham, Silverstream and the Greater Wellington Region, New Zealand.
ogTitle: Pioneer PGD LTD
---

<section class="home-hero">
    <div class="home-hero--inner">
        <div class="home-hero--content">
            <img src="/img/pioneer-logo-white.png" alt="Pioneer PGD logo" class="hero-logo" />
            <h1>Certified Plumbing, Gasfitting and Drainlaying</h1>
            <p class="hero-sub">Owned and operated from Upper Hutt and serving Pinehaven, Trentham, Silverstream, Lower Hutt and the Greater Wellington region.</p>
            <div class="hero-ctas">
                <a href="#services"><button class="button--secondary">Services</button></a>
                <a href="/contact/"><button class="button--primary">Contact now</button></a>
            </div>
        </div>
    </div>
</section>
<!-- TRUST BAR -->
<div class="trust-bar">
    <div class="trust-items">
        <div class="trust-item">
            <h3>Trade Certified</h3>
            <img src="/img/pioneer-certifying-icons.png" alt="Pioneer PGD certified" class="trust-icon" />
        </div>
        <div class="trust-item">
            <div class="trust-stars">
                <img src="/img/star.svg" alt="" class="trust-star" />
                <img src="/img/star.svg" alt="" class="trust-star" />
                <img src="/img/star.svg" alt="" class="trust-star" />
                <img src="/img/star.svg" alt="" class="trust-star" />
                <img src="/img/star.svg" alt="" class="trust-star" />
            </div>
            <a href="{{ reviews.google.url }}" target="_blank" rel="noopener" class="trust-review-link">
                <h3>5 Stars from {{ reviews.google.count }} Google Reviews</h3>
            </a>
        </div>
        <div class="trust-item">
            <h3>Proudly Supported By</h3>
            <img src="/img/pgd-zip-hut-valley.png" alt="Certifying body logo" class="trust-icon" />
        </div>
    </div>
</div>


<!-- SERVICES -->
<section id="services" class="section section-mbl bg-light">
    <div class="section--container | stack-large">
        <span class="section-label">What We Do</span>
        <div class="section--header | stack">
            <h2>Our Services</h2>
            <p class="section-intro">Installation, maintenance and servicing across all three certified trades, one call covers the lot.</p>
        </div>
        <div class="section--wrapper">
            <div class="card-grid card-grid--3">
                {% for s in services %}
                {% if s.type == "trade" %}
                <a href="/services/{{ s.slug }}/" class="home-card home-card--{{ s.name | slug }}">
                    <div class="home-card--img">
                        <img src="{{ s.image }}" alt="{{ s.imageAlt }}" />
                    </div>
                    <div class="home-card--body">
                        <div class="home-card--header">
                            <img class="home-card--icon" src="{{ s.icon }}" alt="{{ s.iconAlt }}" />
                            <h3>{{ s.name }}</h3>
                        </div>
                        <p>{{ s.homeH4 }}</p>
                        <span class="home-card--link">Learn more ›</span>
                    </div>
                </a>
                {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<!-- SPECIALTIES -->
<section id="specialties" class="section section-mbl">
    <div class="section--container | stack-large">
        <span class="section-label">Where We Excel</span>
        <div class="section--header | stack">
            <h2>Our Specialties</h2>
            <p class="section-intro">The jobs we get called for most, and the ones we know inside out.</p>
        </div>
        <div class="section--wrapper">
            <div class="card-grid card-grid--2">
                {% for s in services %}
                {% if s.specialty %}
                <a href="/services/{{ s.slug }}/" class="home-card home-card--specialty">
                    <div class="home-card--img">
                        <img src="{{ s.specialty.image }}" alt="{{ s.specialty.imageAlt }}" />
                    </div>
                    <div class="home-card--body">
                        <div class="home-card--header">
                            <img class="home-card--icon" src="{{ s.icon }}" alt="{{ s.iconAlt }}" />
                            <h3>{{ s.specialty.heading | safe }}</h3>
                        </div>
                    </div>
                </a>
                {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{% include "partials/reviews-section.njk" %}

<!-- AREAS -->
<section id="areas" class="section section-mbl">
    <div class="section--container | stack-large">
        <span class="section-label">Where We Work</span>
        <div class="section--header | stack">
            <h2>Areas We Service</h2>
        </div>
        <div class="section--wrapper">
            <div class="hub-grid">
                {% for card in areas %}{% include "partials/area-card.njk" %}{% endfor %}
            </div>
        </div>
    </div>
</section>

{% include "partials/who-we-are.njk" %}

