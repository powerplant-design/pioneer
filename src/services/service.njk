---
layout: base.njk
tags: service
pagination:
    data: services
    size: 1
    alias: service
permalink: /services/{{ service.slug }}/
---

{% set crumbs = [
    { "name": "Home", "url": "/" },
    { "name": "Services", "url": "/services/" },
    { "name": service.name, "url": "/services/" ~ service.slug ~ "/" }
] %}
{% set heroTitle = service.name %}
{% set heroText = service.intro | safe %}
{% set heroImage = service.image %}
{% set heroAlt = service.imageAlt %}
{% include "partials/hero.njk" %}

{% include "partials/schema-service.njk" %}

<section class="section section-mbl">
    <div class="section--container">
        <div class="service">
            <div class="service--text">
                <div class="service--header">
                    <img src="{{ service.icon }}" alt="{{ service.iconAlt }}" class="service--icon" />
                    {% if service.homeH2 %}<div><h2>{{ service.homeH2 }}</h2></div>{% endif %}
                </div>
                <ul>
                    {% for b in service.bullets %}<li>{{ b }}</li>{% endfor %}
                </ul>
            </div>
        </div>
    </div>
</section>

{% set faqs = service.faqs %}{% include "partials/faq.njk" %}

{% set hasRelated = false %}
{% for s in services %}
{% for r in service.relatedServices %}
{% if s.slug == r %}{% set hasRelated = true %}{% endif %}
{% endfor %}
{% endfor %}
{% if hasRelated %}
<section class="section section-mbl">
    <div class="section--container stack">
        <h2>Related Services</h2>
        <div class="hub-grid">
            {% for s in services %}
            {% for r in service.relatedServices %}
            {% if s.slug == r %}
            {% set tradeSlug = s.trade | lower %}
            <a href="/services/{{ s.slug }}/" class="hub-card hub-card--{{ tradeSlug }}">
                <div class="hub-card--img">
                    {% image s.image, s.imageAlt, [400, 800], "(min-width: 800px) 800px, 400px" %}
                </div>
                <div class="hub-card--body">
                    <div class="hub-card--header">
                        <img class="hub-card--icon" src="{{ s.icon }}" alt="{{ s.iconAlt }}" />
                        <h3 class="{{ s.colourClass }}">{{ s.name }}</h3>
                    </div>
                    <p>{{ s.intro }}</p>
                    <span class="hub-card--more">Learn more ›</span>
                </div>
            </a>
            {% endif %}
            {% endfor %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<!-- REVIEWS -->
{% include "partials/reviews-section.njk" %}

{% include "partials/who-we-are.njk" %}