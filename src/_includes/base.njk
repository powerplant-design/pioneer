<!DOCTYPE html>
<html lang="en">
    <head>
        {% include "partials/head.njk" %}
        {% include "partials/schema-local-business.njk" %}
    </head>

    <body id="top">
        {% include "partials/nav.njk" %}

        <main class="stack">
            {{ content | safe }}
        </main>

        {% include "partials/footer.njk" %}

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const navContact = document.querySelector('.nav-contact');
                if (navContact) {
                    const btn = navContact.querySelector('button');
                    window.addEventListener('scroll', function() {
                        if (window.scrollY > 100) {
                            btn.classList.remove('button--secondary');
                            btn.classList.add('button--primary');
                        } else {
                            btn.classList.remove('button--primary');
                            btn.classList.add('button--secondary');
                        }
                    });
                }

                const breadcrumbs = document.querySelector('.breadcrumbs');
                if (!breadcrumbs) return;
                const nav = document.querySelector('nav');
                const heroText = document.querySelector('.hero--text');
                const MOBILE = 700;
                let currentlyInNav = false;

                function moveBreadcrumbs() {
                    const inMobile = window.innerWidth <= MOBILE;
                    if (inMobile && !currentlyInNav) {
                        nav.appendChild(breadcrumbs);
                        breadcrumbs.classList.add('hide-dsk');
                        breadcrumbs.classList.remove('hide-mbl');
                        const homeLink = breadcrumbs.querySelector('a[href="/"]');
                        const firstSep = homeLink ? homeLink.nextElementSibling : null;
                        if (homeLink) homeLink.remove();
                        if (firstSep) firstSep.remove();
                        currentlyInNav = true;
                    } else if (!inMobile && currentlyInNav) {
                        heroText.insertBefore(breadcrumbs, heroText.firstChild);
                        breadcrumbs.classList.remove('hide-dsk');
                        breadcrumbs.classList.add('hide-mbl');
                        currentlyInNav = false;
                    }
                }
                moveBreadcrumbs();
                window.addEventListener('resize', moveBreadcrumbs);
            });
        </script>
    </body>
</html>
