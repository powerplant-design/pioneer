<section id="reviews" class="section section-mbl bg-light">
    <div class="section--container | stack-large">
        <div class="section--header">
            <h2>Customer Reviews</h2>
        </div>
        <div class="section--wrapper">
            <div class="reviews">
                {% for r in reviews.list %}
                {% if r.isHomepage is defined and r.isHomepage %}
                <div class="review">
                    <div class="stars">
                        {% for i in range(1, r.stars + 1) %}
                        <img class="star" src="/img/star.svg" alt="Star" />
                        {% endfor %}
                    </div>

                    <div class="review--text text-width-med">
                        <div class="stack">
                            {% for p in r.paragraphs %}
                            <p>{{ p | safe }}</p>
                            {% endfor %}
                        </div>

                        <div>
                            <h4>{{ r.author }}</h4>
                            <p>{{ r.location }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}
                {% endfor %}
            </div>
        </div>
        <div class="section--cta" style="text-align: center;">
            <a href="{{ reviews.google.url }}" target="_blank">
                <button class="button--secondary button--logo">
                    <div class="trust-stars">
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                    </div>
                    <div class="button--logo-text">
                        <p>{{ reviews.google.count }} Google Reviews</p>
                    </div>
                    <img class="logo-google" src="/img/logo-google-color.svg" alt="Google Logo" />
                </button>
            </a>
        </div>
    </div>
</section>