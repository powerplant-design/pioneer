<footer>
    <div class="footer--links">
        <div>
            <p class="footer--heading">Services</p>
            {% for s in services %}
            {% if s.type == "trade" %}
            <a href="/services/{{ s.slug }}/">{{ s.name }}</a>
            {% endif %}
            {% endfor %}
            <a href="/services/">All Services</a>
        </div>
        <div>
            <p class="footer--heading">Specialties</p>
            {% for s in services %}
            {% if s.specialty %}
            {% if s.type == "trade" %}
                {% set sUrl = "/services/" ~ s.slug ~ "/" %}
            {% else %}
                {% set sUrl = "/services/" ~ s.trade | lower ~ "/" ~ s.slug ~ "/" %}
            {% endif %}
            <a href="{{ sUrl }}">{{ s.specialty.heading | safe }}</a>
            {% endif %}
            {% endfor %}
        </div>
        <div>
            <p class="footer--heading">Areas</p>
            {% for a in areas %}
            <a href="/areas/{{ a.slug }}/">{{ a.name }}</a>
            {% endfor %}
        </div>
        <div>
            <p class="footer--heading">Company</p>
            <a href="/">Home</a>
            <a href="/about/">About Pioneer PGD</a>
            <a href="/reviews/">Customer Reviews</a>
        </div>
        <div>
            <p class="footer--heading">Contact</p>
            <a href="{{ site.phoneHref }}">{{ site.phone }}</a>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            <a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>
            <a href="https://www.instagram.com/pioneerpgdltd" target="_blank" rel="noopener">Instagram</a>
            <a href="/contact/">Contact form</a>
        </div>
    </div>
    <div class="footer--bottom">
        <div>
            <p>
                &copy; {{ site.legalName }}. {{ currentYear() }}
            </p>
        </div>
        <div>
            <p>Certifying Plumbing, Gasfitting and Drainlaying</p>
        </div>
    </div>
</footer>