{% set tradeSlug = card.trade | lower %}
{% if card.type == "trade" %}
    {% set cardUrl = "/services/" ~ card.slug ~ "/" %}
{% else %}
    {% set cardUrl = "/services/" ~ card.trade | lower ~ "/" ~ card.slug ~ "/" %}
{% endif %}
<a href="{{ cardUrl }}" class="hub-card hub-card--{{ tradeSlug }}">
    <div class="hub-card--img">
        {% image card.image, card.imageAlt, [400, 800], "(min-width: 800px) 800px, 400px" %}
    </div>
    <div class="hub-card--body">
        <div class="hub-card--header">
            <img class="hub-card--icon" src="{{ card.icon }}" alt="{{ card.iconAlt }}" />
            <h3 class="{{ card.colourClass }}">{{ card.name }}</h3>
        </div>
        <p>{{ card.intro }}</p>
        <span class="hub-card--more">Learn more ›</span>
    </div>
</a>
