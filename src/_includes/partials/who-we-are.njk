<!-- WHO WE ARE -->
<section id="about" class="section bg-image">
    <div class="section--container | stack-large">
        <div class="about">
            <div class="about--text | stack">
                <span class="section-label">Why Choose Pioneer PGD</span>
                <h2 class="text-balance">Owner-Operated, Upper Hutt Based</h2>
                <div class="section-content | stack">
                    <p>Pioneer PGD is owned and operated from Silverstream in Upper Hutt, holding certifying plumber, gasfitter and drainlayer licences, the highest level issued for all three trades. One call covers everything, every job is built to code and certified.</p>
                    <p>We hold {{ reviews.google.count }} five-star Google reviews, quote fixed prices after a site visit, and can do certification and consenting for you. No callout surprises, no city-job prioritisation, just local, certified tradespeople.</p>
                </div>
                 <div class="cta-dual">
                    <a href="/contact/"><button class="button--primary">Contact us</button></a>
                    <a href="/about/"><button class="button--secondary">Learn more</button></a>
                </div>
            </div>
            <div class="about--badge">
                {% image "/src/img/pioneer-certifying-icons.png", "Certified Plumbing, Gasfitting and Drainlaying badges", [200, 400], "400px", "about--badge-img" %}
                {% image "/src/img/pgd-zip-hut-valley.png", "Certified Plumbing, Gasfitting and Drainlaying badges", [200, 400], "400px", "about--badge-img" %}
            </div>
        </div>
    </div>
</section>