<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ service.name }}",
    "description": "{{ service.intro | striptags | truncate(300) }}",
    "url": "{{ site.url }}{{ page.url }}",
    "mainEntity": {
        "@type": "ItemList",
        "name": "{{ service.name }} services",
        "itemListElement": [
            {% set first = true %}
            {% set idx = 0 %}
            {% for s in services %}
                {% if s.type == "service" and s.trade == service.name %}
                {% set idx = idx + 1 %}
                {% if not first %},{% endif %}
            {
                "@type": "ListItem",
                "position": {{ idx }},
                "url": "{{ site.url }}/services/{{ s.trade | lower }}/{{ s.slug }}/"
            }
                {% set first = false %}
                {% endif %}
            {% endfor %}
        ]
    }
}
</script>
