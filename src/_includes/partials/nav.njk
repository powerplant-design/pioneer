{% set home = page.url == "/" %}
{% set disableContact = page.url == "/contact/" or page.url == "/thanks/" %}
{% set isContact = page.url == "/contact/" or page.url == "/" %}
<nav>
    <div class="logo-container">
        {% if home %}
        <a href="#top"
            ><img
                class="logo-desktop hide-mbl"
                src="/img/pioneer-logo.png"
                width="400" height="193"
                alt="Pioneer Plumbing Gasfitting and Drainlaying services in the greater Wellington region."
        /><img
                class="logo-mobile hide-dsk"
                src="/img/pioneer-logo-mbl.png"
                width="348" height="48"
                alt="Pioneer Plumbing Gasfitting and Drainlaying services in the greater Wellington region."
        /></a>
        {% else %}
        <a href="/"
            ><img
                class="logo-desktop hide-mbl"
                src="/img/pioneer-logo.png"
                width="400" height="193"
                alt="Pioneer Plumbing Gasfitting and Drainlaying services in the greater Wellington region."
        /><img
                class="logo-mobile hide-dsk"
                src="/img/pioneer-logo-mbl.png"
                width="348" height="48"
                alt="Pioneer Plumbing Gasfitting and Drainlaying services in the greater Wellington region."
        /></a>
        {% endif %}
    </div>
    
    <div class="nav--links">
        <div class="nav--links_mbl">
            <a href="/services/">Services</a>
            <a href="/areas/">Areas</a>
            <a href="/about/">About</a>
            <a href="/reviews">Reviews</a>
        </div>
        <a href="/contact/" class="hide-dsk button--primary{% if disableContact %} disable{% endif %}">Contact Now</a>
        <a href="/contact/" class="hide-mbl nav-contact button--secondary{% if disableContact %} disable{% endif %}">Contact Now</a>
    </div>
</nav>
<script>
(function() {
    const nav = document.querySelector('.nav--links_mbl');
    if (!nav) return;
    const mq = window.matchMedia('(max-width: 700px)');
    let lastY = window.scrollY;
    let ticking = false;
    function onScroll() {
        if (!ticking) {
            window.requestAnimationFrame(function() {
                const y = window.scrollY;
                if (mq.matches) {
                    if (y <= 10 || (y < lastY && y > 10)) {
                        nav.classList.add('is-visible');
                    } else {
                        nav.classList.remove('is-visible');
                    }
                }
                lastY = y;
                ticking = false;
            });
            ticking = true;
        }
    }
    if (mq.matches && window.scrollY <= 10 && !{{ isContact | dump }}) nav.classList.add('is-visible');
    window.addEventListener('scroll', onScroll, { passive: true });
})();
</script>
