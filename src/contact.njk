---
layout: base.njk
title: Pioneer PGD Contact
description: Plumbing, Gasfitting and Drainlaying servicing Upper Hutt, Pinehaven, Trentham, Silverstream and the Greater Wellington Region, New Zealand.
ogTitle: Pioneer PGD LTD
---

<section id="contact" class="section contact">
    <div class="contact--wrapper">
        <div class="section--header hide-mbl">
            <h2 class="center">Contact</h2>
        </div>
        <div class="container--contact">
            <div class="container--contact-inner">
                <p class="center pad-bottom-large">
                        Enquire about a job and we'll be in touch
                    </p>
                <form
                    name="contact"
                    action="/thanks/"
                    method="POST"
                    netlify-honeypot="bot-field"
                    data-netlify="true"
                >
                    <div class="form-5050">
                        <label class="form-50"
                            ><input
                                required
                                type="text"
                                id="name"
                                name="Name"
                                aria-label="Name"
                                placeholder="Name"
                        /></label>

                        <label class="form-50">
                            <input
                                required
                                type="tel"
                                id="phone-number"
                                name="Phone"
                                aria-label="Phone"
                                placeholder="Phone"
                        /></label>
                    </div>
                    <label class="hidden">
                        <input
                            name="bot-field"
                            type="text"
                            id="bot-field"
                            aria-label="Location"
                            placeholder="Location"
                        />
                    </label>
                    <label>
                        <input
                            required
                            type="email"
                            id="email"
                            name="Email"
                            aria-label="Email"
                            placeholder="Email"
                    /></label>

                    <label>
                        <input
                            type="text"
                            id="address"
                            name="Address"
                            aria-label="Address"
                            placeholder="Address"
                    /></label>

                    <label>
                        <textarea
                            id="job-enquiry"
                            name="job-enquiry"
                            aria-label="Job Enquiry"
                            placeholder="Job Enquiry"
                        ></textarea>
                    </label>

                    <button class="button--primary" type="submit">
                        Send
                    </button>
                </form>
            </div>

            <div class="container--contact-inner contacts">
                <div class="info stack">
                    <div class="center-tablet">
                        <img src="/img/pioneer-certified.svg" alt="Pioneer Certified Plumbing Gasfitting and Drainlaying" class="hero--certified" />

                    </div>
                    <p>
                        <a
                            href="{{ site.googleMapsUrl }}"
                            target="_blank"
                        >
                            Certifying Plumbing, Gasfitting and
                            Drainlaying.
                        </a>
                    </p>
                    <p>
                        {{ site.serviceAreaText }}
                    </p>
                    <p>Monday&#8212;Friday | 9am&#8212;5pm</p>
                </div>
                <div class="info--contacts">
                    <div class="contact--single">
                        <img
                            src="/img/icon-phone-rounded.svg"
                            alt="Phone Icon"
                            class="contact--icon"
                        />
                        <a href="{{ site.phoneHref }}"
                            >{{ site.phone }}</a
                        >
                        <p class="call-now">
                            &#8592; Click to call now
                        </p>
                    </div>
                    <div class="contact--single">
                        <img
                            src="/img/icon-email-rounded.svg"
                            alt="Email Icon"
                            class="contact--icon"
                        />
                        <a
                            href="mailto:{{ site.email }}"
                            target="_blank"
                        >
                            {{ site.email }}</a
                        >
                    </div>

                    <div class="contact--single">
                        <img
                            src="/img/icon-fb.svg"
                            alt="Facebook Icon"
                            class="contact--icon"
                        />
                        <a
                            href="{{ site.facebook }}"
                            target="_blank"
                            rel="noopener"
                        >
                            PioneerPGD</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
