---
layout: base.njk
tags: area
pagination:
    data: areas
    size: 1
    alias: area
permalink: /areas/{{ area.slug }}/
---

<div class="page | stack-large">
    {% set crumbs = [
        { "name": "Home", "url": "/" },
        { "name": "Areas", "url": "/areas/" },
        { "name": area.name, "url": "/areas/" ~ area.slug ~ "/" }
    ] %}
    {% set heroTitle = area.name %}
    {% set heroText = area.intro | safe %}
    {% set heroImage = area.image %}
    {% set heroAlt = area.imageAlt %}
    {% include "partials/hero.njk" %}

    <section class="section section-mbl">
        <div class="section--container stack">
            <h2 class="text-balance">Local Knowledge for {{ area.name }}</h2>
            <div class="local-notes stack">
                {% for n in area.localNotes %}<p>{{ n | replace("{{reviews.google.count}}", reviews.google.count) | safe }}</p>{% endfor %}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section--container stack">
            <h2>Suburbs We Service</h2>
            <div class="suburb-chips">
                {% for sub in area.suburbs %}<span class="suburb-chip">{{ sub }}</span>{% endfor %}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section--container stack">
            <h2>Services in {{ area.name }}</h2>
            <div class="hub-grid">
                {% set areaSlug = area.slug %}
                {% for s in services %}
                    {% set isAreaMatch = s.slug.endsWith("-" + areaSlug) %}
                    {% set isOtherArea = false %}
                    {% for a in areas %}
                        {% if a.slug != areaSlug and s.slug.endsWith("-" + a.slug) %}
                            {% set isOtherArea = true %}
                        {% endif %}
                    {% endfor %}
                    {% if isAreaMatch %}
                    {% set tradeSlug = s.trade | lower %}
                    {% if s.type == "trade" %}
                        {% set sUrl = "/services/" ~ s.slug ~ "/" %}
                    {% else %}
                        {% set sUrl = "/services/" ~ s.trade | lower ~ "/" ~ s.slug ~ "/" %}
                    {% endif %}
                    <a href="{{ sUrl }}" class="hub-card hub-card--{{ tradeSlug }}">
                        <div class="hub-card--img">
                            {% image s.image, s.imageAlt, [400, 800], "(min-width: 800px) 800px, 400px" %}
                        </div>
                        <div class="hub-card--body">
                            <div class="hub-card--header">
                                <img class="hub-card--icon" src="{{ s.icon }}" alt="{{ s.iconAlt }}" />
                                <h3 class="{{ s.colourClass }}">{{ s.name }}</h3>
                            </div>
                            <p>{{ s.intro }}</p>
                            <span class="hub-card--more">Learn more ›</span>
                        </div>
                    </a>
                    {% endif %}
                {% endfor %}
                {% for s in services %}
                    {% set isAreaMatch = s.slug.endsWith("-" + areaSlug) %}
                    {% set isOtherArea = false %}
                    {% for a in areas %}
                        {% if a.slug != areaSlug and s.slug.endsWith("-" + a.slug) %}
                            {% set isOtherArea = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not isAreaMatch and not isOtherArea %}
                    {% set tradeSlug = s.trade | lower %}
                    {% if s.type == "trade" %}
                        {% set sUrl = "/services/" ~ s.slug ~ "/" %}
                    {% else %}
                        {% set sUrl = "/services/" ~ s.trade | lower ~ "/" ~ s.slug ~ "/" %}
                    {% endif %}
                    <a href="{{ sUrl }}" class="hub-card hub-card--{{ tradeSlug }}">
                        <div class="hub-card--img">
                            {% image s.image, s.imageAlt, [400, 800], "(min-width: 800px) 800px, 400px" %}
                        </div>
                        <div class="hub-card--body">
                            <div class="hub-card--header">
                                <img class="hub-card--icon" src="{{ s.icon }}" alt="{{ s.iconAlt }}" />
                                <h3 class="{{ s.colourClass }}">{{ s.name }}</h3>
                            </div>
                            <p>{{ s.intro }}</p>
                            <span class="hub-card--more">Learn more ›</span>
                        </div>
                    </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>

    {% set faqs = area.faqs %}{% include "partials/faq.njk" %}

    {% include "partials/who-we-are.njk" %}
</div>
