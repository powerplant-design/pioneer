---
layout: base.njk
title: Customer Reviews - Pioneer PGD
description: Read customer reviews for Pioneer PGD plumbing, gasfitting and drainlaying services
---
<section id="reviews" class="section  section-mbl bg-light | stack-large pad-top-nav-height">
    <div class="section--container | stack-large">
        <h1 class="center">Customer Reviews</h1>
        <div class="section--wrapper">
            <div class="reviews">
                {% for r in reviews.list %}
                <!-- Added the conditional 'is-long' class here -->
                <div class="review {{ 'is-long' if r.isLong }}">
                    <div class="stars">
                        {% for i in range(1, r.stars + 1) %}
                        <img class="star" src="/img/star.svg" alt="Star" />
                        {% endfor %}
                    </div>

                    <div class="review--text text-width-med">
                        <div class="stack">
                            {% for p in r.paragraphs %}
                            <p>{{ p | safe }}</p>
                            {% endfor %}
                        </div>

                        <div>
                            <p class="review--author">{{ r.author }}</p>
                            <p>{{ r.location }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="section--cta" style="text-align: center;">
            <a href="{{ reviews.google.url }}" target="_blank" class="button--secondary button--logo">
                    <div class="trust-stars">
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                        <img src="/img/star.svg" alt="" class="trust-star" />
                    </div>
                    <div class="button--logo-text">
                        <p>{{ reviews.google.count }} Google Reviews</p>
                    </div>
                    <img class="logo-google" src="/img/logo-google-color.svg" alt="Google Logo" />
            </a>
        </div>
</section>

{% include "partials/who-we-are.njk" %}

